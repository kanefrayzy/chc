// CHCGREEN — Prisma schema
// Денежные значения хранятся в минорных единицах (qəpik, 1 AZN = 100) как BigInt.
// См. docs/decisions.md ADR-0003.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// USERS & AUTH
// =========================================================

enum UserRole {
  USER
  MODERATOR
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  MUTED
}

model User {
  id              String     @id @default(cuid())
  email           String?    @unique
  phone           String?    @unique
  username        String     @unique
  passwordHash    String
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  language        String     @default("ru") // 'ru' | 'az'
  // referral
  referralCode    String     @unique
  referredById    String?
  referredBy      User?      @relation("UserReferrals", fields: [referredById], references: [id])
  referrals       User[]     @relation("UserReferrals")
  // wallet
  balanceMinor    BigInt     @default(0) // qəpik
  // Накопленная маржа казино по этому игроку, ещё не отработанная реферальным
  // бонусом. Отрицательное значение = казино в минусе по игроку и бонус его
  // пригласившему не начисляется, пока минус не отыграется (см. ADR-0008).
  referralCarryMinor BigInt  @default(0)
  // metrics
  totalWageredMinor BigInt   @default(0)
  rankId          String?
  rank            Rank?      @relation(fields: [rankId], references: [id])
  // misc
  avatarUrl       String?
  lastLoginAt     DateTime?
  lastLoginIp     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  refreshTokens   RefreshToken[]
  transactions    Transaction[]
  deposits        Deposit[]
  withdrawals     Withdrawal[]
  codePurchases   CodePurchase[]
  tickets         Ticket[]         @relation("TicketUser")
  assignedTickets Ticket[]         @relation("TicketModerator")
  messages        Message[]
  rouletteBets    RouletteBet[]
  minesGames      MinesGame[]
  jackpotBets     JackpotBet[]
  caseOpenings    CaseOpening[]
  auditLogs       AuditLog[]
  referralEarnings ReferralEarning[] @relation("EarningReferrer")
  referralFromMe   ReferralEarning[] @relation("EarningReferred")
  lotteryTickets   LotteryTicket[]
  boughtCodes      CodeItem[]
  progressiveWins  ProgressiveJackpotWin[]

  @@index([email])
  @@index([username])
  @@index([referralCode])
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
}

// =========================================================
// FINANCE (immutable ledger)
// =========================================================

enum TransactionType {
  DEPOSIT
  WITHDRAW
  BET_PLACE
  BET_WIN
  BET_REFUND
  CODE_HOLD
  CODE_RELEASE
  CODE_REFUND
  REFERRAL_EARNING
  ADMIN_ADJUSTMENT
  ADMIN_CREDIT
  ADMIN_DEBIT
  CASE_OPEN
  CASE_WIN
  JACKPOT_BET
  JACKPOT_WIN
  JACKPOT_COMMISSION
  PROGRESSIVE_WIN
  CODE_SHOP_BUY
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REVERSED
  FAILED
}

model Transaction {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  type          TransactionType
  status        TransactionStatus @default(COMPLETED)
  amountMinor   BigInt            // знаковая сумма: + поступление, - списание
  balanceAfterMinor BigInt
  // idempotency / связь с источником
  idempotencyKey String?          @unique
  referenceType String?           // 'deposit' | 'withdrawal' | 'roulette_bet' | ...
  referenceId   String?
  // meta
  description   String?
  metadata      Json?
  createdAt     DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
  @@index([type])
}

// =========================================================
// PAYMENTS
// =========================================================

enum PaymentProvider {
  BETATRANSFER // https://docs.betatransfer.io (см. ADR-0007)
  WESTWALLET
}

enum PaymentMethodKind {
  DEPOSIT
  WITHDRAWAL
  BOTH
}

// Конфигурируемый платёжный метод. Создаётся в админке.
// Один логический метод (например «Карта AZN», «USDT TRC-20», «BTC»)
// маппится на конкретный агрегатор (`provider`) и хранит провайдер-специфичный
// `config` (для BETATRANSFER: { paymentSystem? }; для WESTWALLET: { ticker, dest_tag? }).
model PaymentMethod {
  id                String            @id @default(cuid())
  name              String            // отображаемое название («Карта AZN», «USDT TRC-20»)
  provider          PaymentProvider
  kind              PaymentMethodKind @default(BOTH)
  currency          String            // ISO-код («AZN», «RUB», «USDT», «BTC»)
  iconUrl           String?           // URL в MinIO (или внешний)
  description       String?
  // отображаемые лимиты в минорных единицах ВНУТРЕННЕЙ валюты (AZN)
  minAmountMinor    BigInt            @default(0)
  maxAmountMinor    BigInt            @default(0) // 0 = без лимита
  displayOrder      Int               @default(0)
  enabled           Boolean           @default(true)
  // провайдер-специфичные настройки (aggregators, ticker, dest_tag, и пр.)
  config            Json              @default("{}")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  deposits          Deposit[]
  withdrawals       Withdrawal[]

  @@index([enabled, kind])
  @@index([provider])
}

enum DepositStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

model Deposit {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  provider      PaymentProvider
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  status        DepositStatus   @default(PENDING)
  // суммы в минорных единицах AZN
  amountMinor   BigInt
  // оригинальные суммы провайдера (для крипты: USDT и т.п.)
  originalAmount     String?    // строковое представление (Decimal)
  originalCurrency   String?
  exchangeRate       String?    // курс на момент зачисления
  // внешние идентификаторы
  externalId    String?         @unique
  externalAddress String?       // реквизит для перевода: карта / адрес кошелька
  // доп. данные реквизита от провайдера: { bank?, owner?, type? } — показываются пользователю
  requisiteDetails Json?
  paymentUrl    String?
  // webhook-данные
  rawWebhookPayload Json?
  // авторство (если ручная корректировка)
  createdAt     DateTime        @default(now())
  completedAt   DateTime?
  expiresAt     DateTime?

  @@index([userId])
  @@index([status])
  @@index([provider, externalId])
  @@index([paymentMethodId])
}

enum WithdrawalStatus {
  PENDING       // в очереди
  PROCESSING    // взято модератором / отправляется
  COMPLETED
  REJECTED
  FAILED
  CANCELLED
}

enum WithdrawalMethod {
  AUTO_BETATRANSFER
  AUTO_WESTWALLET
  MANUAL_MODERATOR
}

model Withdrawal {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  method        WithdrawalMethod
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  status        WithdrawalStatus @default(PENDING)
  amountMinor   BigInt
  destination   Json             // адрес/реквизиты (карта, кошелёк), маскированные
  // обработка
  processedByModeratorId String?
  externalId    String?
  rawWebhookPayload Json?
  reason        String?          // причина отказа
  createdAt     DateTime         @default(now())
  completedAt   DateTime?

  @@index([userId])
  @@index([status])
  @@index([paymentMethodId])
}

// =========================================================
// CODE PURCHASES (покупка кода для стороннего казино через чат)
// =========================================================

enum CodePurchaseStatus {
  CREATED            // юзер нажал "купить код"
  AWAITING_MODERATOR // ждёт ответа в чате
  CODE_ISSUED        // модератор прислал код
  COMPLETED          // средства списаны, тикет закрыт
  CANCELLED          // отмена, hold возвращён
}

model CodePurchase {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id])
  ticketId      String?            @unique
  ticket        Ticket?            @relation(fields: [ticketId], references: [id])
  amountMinor   BigInt             // сумма hold
  status        CodePurchaseStatus @default(CREATED)
  code          String?            // выданный код
  issuedByModeratorId String?
  createdAt     DateTime           @default(now())
  completedAt   DateTime?

  @@index([userId])
  @@index([status])
}

// =========================================================
// CHAT (тикеты с модератором)
// =========================================================

enum TicketType {
  CODE_PURCHASE
  WITHDRAWAL
  SUPPORT
}

enum TicketStatus {
  OPEN
  WAITING_USER
  WAITING_MODERATOR
  CLOSED
}

model Ticket {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation("TicketUser", fields: [userId], references: [id])
  moderatorId   String?
  moderator     User?         @relation("TicketModerator", fields: [moderatorId], references: [id])
  type          TicketType
  status        TicketStatus  @default(OPEN)
  subject       String?
  metadata      Json?
  closedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  messages      Message[]
  codePurchase  CodePurchase?

  @@index([userId])
  @@index([moderatorId])
  @@index([status])
}

enum MessageKind {
  TEXT
  FILE
  SYSTEM
  ACTION   // действие модератора (списание, выдача кода и т.п.)
}

model Message {
  id          String      @id @default(cuid())
  ticketId    String
  ticket      Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?       @relation(fields: [authorId], references: [id])
  kind        MessageKind @default(TEXT)
  body        String
  attachmentUrl String?
  attachmentMime String?
  attachmentSize Int?
  readByUserAt    DateTime?
  readByModeratorAt DateTime?
  createdAt   DateTime    @default(now())

  @@index([ticketId, createdAt])
}

model ChatTemplate {
  id        String   @id @default(cuid())
  title     String
  body      String
  language  String   @default("ru")
  createdAt DateTime @default(now())
}

// =========================================================
// GAMES: ROULETTE BATTLE (MVP)
// =========================================================

enum RouletteColor {
  BLACK
  RED
  GREEN
}

enum RouletteRoundStatus {
  BETTING
  ROLLING
  COMPLETED
  CANCELLED
}

model RouletteRound {
  id              String              @id @default(cuid())
  status          RouletteRoundStatus @default(BETTING)
  serverSeedHash  String              // публикуется до раунда
  serverSeed      String?             // раскрывается после
  publicSeed      String?             // например, hash блока + nonce
  winningColor    RouletteColor?
  winningSlot     Int?
  startedAt       DateTime            @default(now())
  bettingEndsAt   DateTime
  completedAt     DateTime?

  bets            RouletteBet[]

  @@index([status])
  @@index([startedAt])
}

model RouletteBet {
  id          String        @id @default(cuid())
  roundId     String
  round       RouletteRound @relation(fields: [roundId], references: [id])
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  color       RouletteColor
  amountMinor BigInt
  payoutMinor BigInt        @default(0)
  isWinner    Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([roundId])
  @@index([userId])
}

// =========================================================
// GAMES: MINES (single-player, provably fair)
// =========================================================

enum MinesGameStatus {
  ACTIVE
  CASHED_OUT
  BUSTED
  CANCELLED
}

/// Партия Mines на сетке 5×5 (TOTAL_TILES = 25).
/// minePositions хранит индексы клеток с минами (отсортированный массив).
/// revealedTiles — список открытых безопасных клеток в порядке открытия.
/// Для активной игры minePositions и serverSeed клиенту НЕ отдаются (анти-чит).
model MinesGame {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  status          MinesGameStatus @default(ACTIVE)
  betMinor        BigInt
  mineCount       Int             // 1..24
  // provably fair
  serverSeed      String          // раскрывается клиенту после завершения
  serverSeedHash  String          // публикуется сразу
  clientSeed      String
  nonce           Int             @default(0)
  minePositions   Int[]           // длина = mineCount
  revealedTiles   Int[]           // длина 0..(25 - mineCount)
  // выплата
  multiplierBps   Int             @default(10000) // 10000 = ×1.0000
  payoutMinor     BigInt          @default(0)
  // время
  startedAt       DateTime        @default(now())
  completedAt    DateTime?

  @@index([userId, status])
  @@index([userId, startedAt])
}

// =========================================================
// GAMES: JACKPOT (Phase 2)
// =========================================================

enum JackpotRoundStatus {
  OPEN
  ROLLING
  COMPLETED
  CANCELLED
}

model JackpotRound {
  id              String             @id @default(cuid())
  status          JackpotRoundStatus @default(OPEN)
  serverSeedHash  String
  serverSeed      String?
  publicSeed      String?
  bankMinor       BigInt             @default(0)
  commissionRateBps Int              @default(700) // 7% по умолчанию
  winnerId        String?
  winningTicket   Int?
  startedAt       DateTime           @default(now())
  endsAt          DateTime
  completedAt     DateTime?

  bets            JackpotBet[]

  @@index([status])
}

model JackpotBet {
  id          String       @id @default(cuid())
  roundId     String
  round       JackpotRound @relation(fields: [roundId], references: [id])
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  amountMinor BigInt
  ticketsFrom Int          // диапазон билетов для расчёта победителя
  ticketsTo   Int
  createdAt   DateTime     @default(now())

  @@index([roundId])
  @@index([userId])
}

// =========================================================
// GAMES: CASES (Phase 3)
// =========================================================

model Case {
  id          String       @id @default(cuid())
  slug        String       @unique
  nameRu      String
  nameAz      String
  priceMinor  BigInt
  imageUrl    String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  items       CaseItem[]
  openings    CaseOpening[]
}

model CaseItem {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  nameRu          String
  nameAz          String
  prizeMinor      BigInt   // выплачивается на баланс
  probabilityBps  Int      // 1..10000 (basis points)
  imageUrl        String?

  @@index([caseId])
}

model CaseOpening {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  prizeMinor  BigInt
  itemId      String?
  serverSeed  String
  publicSeed  String
  resultHash  String
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([caseId])
}

// =========================================================
// REFERRALS
// =========================================================

enum ReferralEarningKind {
  FROM_LOSS     // % от чистой маржи казино по игроку (ADR-0008)
  FROM_WIN      // не используется с ADR-0008, оставлен для старых записей
  FROM_DEPOSIT  // % от суммы пополнения приглашённого
}

model ReferralEarning {
  id            String              @id @default(cuid())
  referrerId    String
  referrer      User                @relation("EarningReferrer", fields: [referrerId], references: [id])
  referredId    String
  referred      User                @relation("EarningReferred", fields: [referredId], references: [id])
  kind          ReferralEarningKind
  sourceAmountMinor BigInt
  earningMinor  BigInt
  rateBps       Int
  // ссылка на источник (bet/transaction)
  referenceType String?
  referenceId   String?
  createdAt     DateTime            @default(now())

  @@index([referrerId, createdAt])
  @@index([referredId])
}

// =========================================================
// RANKS / VIP
// =========================================================

model Rank {
  id                String  @id @default(cuid())
  order             Int     @unique
  slug              String  @unique
  nameRu            String
  nameAz            String
  minWageredMinor   BigInt
  iconUrl           String?

  users             User[]
}

// =========================================================
// ADMIN / SETTINGS / AUDIT
// =========================================================

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])
  action      String   // 'wallet.adjust' | 'ticket.assign' | ...
  entityType  String?
  entityId    String?
  payload     Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// =========================================================
// PROGRESSIVE JACKPOT (4 копилки, растут с каждой ставки)
// =========================================================

enum ProgressiveTier {
  GRAND
  MAJOR
  MINOR
  MINI
}

/// Одна копилка. Пополняется долей от каждой ставки (contributionBps),
/// после розыгрыша откатывается к seedMinor. Строк ровно четыре.
model ProgressiveJackpot {
  tier            ProgressiveTier @id
  seedMinor       BigInt          @default(0)  // стартовая сумма после срыва
  currentMinor    BigInt          @default(0)
  contributionBps Int             @default(0)  // доля ставки в этот пул
  enabled         Boolean         @default(true)
  lastWonAt       DateTime?
  lastWinnerName  String?
  lastWinMinor    BigInt          @default(0)
  updatedAt       DateTime        @updatedAt
}

model ProgressiveJackpotWin {
  id                   String          @id @default(cuid())
  tier                 ProgressiveTier
  userId               String
  user                 User            @relation(fields: [userId], references: [id])
  amountMinor          BigInt
  awardedByModeratorId String?
  createdAt            DateTime        @default(now())

  @@index([createdAt])
  @@index([userId])
}

// =========================================================
// CODE SHOP (магазин готовых кодов стороннего казино)
// =========================================================

/// Номинал в продаже: «Код 5 AZN». Цена задаётся отдельно от номинала,
/// чтобы можно было делать скидку или наценку без перезаливки кодов.
model CodeProduct {
  id                String     @id @default(cuid())
  name              String
  denominationMinor BigInt                          // номинал кода
  priceMinor        BigInt                          // сколько списываем с баланса
  description       String?
  iconUrl           String?
  displayOrder      Int        @default(0)
  enabled           Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  items             CodeItem[]

  @@index([enabled, displayOrder])
}

enum CodeItemStatus {
  AVAILABLE
  SOLD
  DISABLED
}

model CodeItem {
  id         String         @id @default(cuid())
  productId  String
  product    CodeProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  code       String
  status     CodeItemStatus @default(AVAILABLE)
  soldToId   String?
  soldTo     User?          @relation(fields: [soldToId], references: [id])
  soldAt     DateTime?
  priceMinor BigInt?                                // цена на момент продажи
  createdAt  DateTime       @default(now())

  @@unique([productId, code])
  @@index([productId, status])
  @@index([soldToId, soldAt])
}

// =========================================================
// LOTTERY (моментальная лотерея «три в ряд»)
// =========================================================

model LotteryTicket {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  betMinor       BigInt
  prizeMinor     BigInt   @default(0)
  symbols        Int[]                    // 9 индексов призовых уровней
  winningSymbol  Int?                     // индекс уровня, если выпало три в ряд
  // provably fair
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}
