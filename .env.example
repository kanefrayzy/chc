# ===== Brand =====
SITE_NAME=CHCGREEN
SITE_PRIMARY_COLOR=#00ff88

# ===== Postgres =====
POSTGRES_USER=chcgreen
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=chcgreen
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chcgreen:changeme_strong_password@postgres:5432/chcgreen?schema=public

# ===== Redis =====
REDIS_PASSWORD=changeme_redis_password
REDIS_PORT=6379
REDIS_URL=redis://:changeme_redis_password@redis:6379

# ===== MinIO (S3-compatible) =====
MINIO_ROOT_USER=chcgreen_minio
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_BUCKET=chcgreen-uploads
S3_ACCESS_KEY=chcgreen_minio
S3_SECRET_KEY=changeme_minio_password
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ===== JWT =====
JWT_ACCESS_SECRET=replace_me_with_long_random_string_min_64_chars_123456789012345678
JWT_REFRESH_SECRET=replace_me_with_different_long_random_string_64_chars_12345678901234
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ===== Apps =====
NODE_ENV=production
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
ADMIN_PORT=3001
ADMIN_PUBLIC_URL=http://localhost:3001
REALTIME_PORT=4001
REALTIME_PUBLIC_URL=http://localhost:4001

# Public-side (exposed to browser via Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001
NEXT_PUBLIC_SITE_NAME=CHCGREEN

# ===== Payments: Betra h2h (UI = "Limpay") =====
BETRA_H2H_API_URL=https://betra.game/api
BETRA_H2H_API_KEY=
BETRA_H2H_WEBHOOK_SECRET=

# ===== Payments: WestWallet (crypto) =====
WESTWALLET_API_URL=https://api.westwallet.io
WESTWALLET_PUBLIC_KEY=
WESTWALLET_PRIVATE_KEY=
WESTWALLET_WEBHOOK_PUBLIC_KEY=

# ===== Limits (минорные единицы = qəpik, 1 AZN = 100) =====
DEPOSIT_MIN_MINOR=500
DEPOSIT_MAX_MINOR=1000000000
WITHDRAW_MIN_MINOR=1000
WITHDRAW_MAX_MINOR=500000000
WITHDRAW_DAILY_MAX_MINOR=2000000000
