{
  "name": "chcgreen",
  "version": "0.1.0",
  "private": true,
  "description": "CHCGREEN — онлайн-платформа: продажа кодов для казино + собственные игры",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @chcgreen/db prisma:generate",
    "db:migrate": "pnpm --filter @chcgreen/db prisma:migrate:deploy",
    "docker:build": "docker compose --env-file .env build",
    "docker:up": "docker compose --env-file .env up -d",
    "docker:down": "docker compose --env-file .env down",
    "docker:logs": "docker compose --env-file .env logs -f"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
